{
  "name": "cyco77-pcf-lib",
  "version": "1.2.31",
  "private": true,
  "scripts": {
    "build": "dotnet build ./Solution/Solution.cdsproj -c Release",
    "release:build": "npm run version:build && dotnet build ./Solution/Solution.cdsproj -c Release",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:all": "npm run test && npm run test:browser",
    "version:build": "node ./scripts/bump-version.mjs patch",
    "version:minor": "node ./scripts/bump-version.mjs minor",
    "version:major": "node ./scripts/bump-version.mjs major"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/browser-playwright": "^4.1.6",
    "jsdom": "^26.1.0",
    "playwright": "^1.61.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remark-gfm": "^4.0.1",
    "vite": "^7.1.7",
    "vitest": "^4.1.6"
  }
}
